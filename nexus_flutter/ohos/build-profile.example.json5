{
  // Copy to build-profile.json5 locally, then configure signing in DevEco Studio
  // or replace the placeholders with values from your ignored local profile.
  // This SDK does not safely interpolate environment variables in JSON5.
  "app": {
    "signingConfigs": [
      {
        "name": "default",
        "type": "HarmonyOS",
        "material": {
          "certpath": "./certs/debug.cer",
          "keyAlias": "debugKey",
          "keyPassword": "REPLACE_WITH_LOCAL_KEY_PASSWORD",
          "profile": "./certs/debug.p7b",
          "signAlg": "SHA256withECDSA",
          "storeFile": "./certs/debug.p12",
          "storePassword": "REPLACE_WITH_LOCAL_STORE_PASSWORD"
        }
      }
    ],
    "products": [
      {
        "name": "default",
        "signingConfig": "default",
        "compatibleSdkVersion": "5.0.0(12)",
        "runtimeOS": "HarmonyOS",
        "targetSdkVersion": "5.0.0(12)"
      }
    ],
    "buildModeSet": [
      {
        "name": "debug"
      },
      {
        "name": "profile"
      },
      {
        "name": "release"
      }
    ],
    "capabilities": [
      {
        "bundleName": "com.nexus.remoteai",
        "config": [
          {
            "name": "Push Kit",
            "capability": "com.huawei.service.push.base_service"
          }
        ]
      }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default"
          ]
        }
      ]
    }
  ]
}
