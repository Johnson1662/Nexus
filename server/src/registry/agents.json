        "executables": ["omp"]
      },
      "native": {
        "enabled": true,
        "command": "omp",
        "args": ["acp"]
      },
      "herdr": {
        "enabled": true,
        "kind": "omp",
        "integration": "omp"
      },
      "capabilities": {
        "nativeAcp": true,
        "herdr": true,
        "structuredHistory": true,
        "modelSelection": true,
        "modeSelection": true,
        "authentication": true
      },
      "distribution": {
        "direct": {
          "cmd": "omp",
          "args": ["acp"]
        }
      }
